+enum {
+    AFME_EVENT_INPUT = 1 << 0,
+    AFME_EVENT_NO_FUNCTION = 1 << 1,
+    AFME_EVENT_DISABLED_AFTER_GL_ERROR = 1 << 2,
+    AFME_EVENT_UNSUPPORTED_FORMAT = 1 << 3,
+    AFME_EVENT_SOURCE_MISMATCH = 1 << 4,
+    AFME_EVENT_OUTPUT_ALLOC = 1 << 5,
+    AFME_EVENT_RAW_TEXTURE = 1 << 6,
+    AFME_EVENT_INPUT_ALLOC = 1 << 7,
+};
+
+static void afme_report_event(struct gl_video *p, uint32_t event,
+                              const char *message)
+{
+    if (p->afme_reported_events & event)
+        return;
+    p->afme_reported_events |= event;
+    MP_WARN(p, "Adreno AFME debug: %s\n", message);
+}
+
+static bool afme_format_supported(struct gl_video *p, struct ra_tex *tex,
+                                  GLint *out_internal_format)
+{
+    if (!ra_is_gl(p->ra) || !tex || tex->params.dimensions != 2)
+        return false;
+
+    GLint internal_format = 0;
+    GLenum format = 0;
+    GLenum type = 0;
+    ra_gl_get_format(tex->params.format, &internal_format, &format, &type);
+    if (out_internal_format)
+        *out_internal_format = internal_format;
+    (void)format;
+    (void)type;
+
+    switch (internal_format) {
+    case GL_RGBA8:
+    case GL_RGB8:
+        return true;
+    default:
+        return false;
+    }
+}
+
+static void afme_report_stats(struct gl_video *p)
+{
+    int64_t now_ns = mp_time_ns();
+    if (!p->afme_stats_last_ns) {
+        p->afme_stats_last_ns = now_ns;
+        return;
+    }
+
+    int64_t elapsed_ns = now_ns - p->afme_stats_last_ns;
+    if (elapsed_ns < MP_TIME_S_TO_NS(1))
+        return;
+
+    uint64_t presented = p->afme_stats_phase[0] +
+                         p->afme_stats_phase[1] +
+                         p->afme_stats_phase[2];
+    double elapsed = MP_TIME_NS_TO_S(elapsed_ns);
+    MP_INFO(p, "Adreno AFME debug: present=%.1f fps phases=%llu/%llu/%llu "
+            "generated-present=%llu pair-requests=%llu cache-hits=%llu "
+            "generated-pairs=%llu bypass-invalid=%llu bypass-still=%llu\n",
+            presented / elapsed,
+            (unsigned long long)p->afme_stats_phase[0],
+            (unsigned long long)p->afme_stats_phase[1],
+            (unsigned long long)p->afme_stats_phase[2],
+            (unsigned long long)p->afme_stats_generated_present,
+            (unsigned long long)p->afme_stats_pair_requests,
+            (unsigned long long)p->afme_stats_pair_cache_hits,
+            (unsigned long long)p->afme_stats_pair_generated,
+            (unsigned long long)p->afme_stats_bypass_invalid,
+            (unsigned long long)p->afme_stats_bypass_still);
+
+    p->afme_stats_last_ns = now_ns;
+    memset(p->afme_stats_phase, 0, sizeof(p->afme_stats_phase));
+    p->afme_stats_generated_present = 0;
+    p->afme_stats_pair_requests = 0;
+    p->afme_stats_pair_cache_hits = 0;
+    p->afme_stats_pair_generated = 0;
+    p->afme_stats_bypass_invalid = 0;
+    p->afme_stats_bypass_still = 0;
+}
+
+static const struct ra_format *afme_fixed_format(struct gl_video *p)
+{
+    // Qualcomm's reference implementation allocates GL_RGB8 source and
+    // output textures. Prefer that exact path, with RGBA8 as the fixed-point
+    // fallback when the renderer does not expose a renderable rgb8 format.
+    const struct ra_format *format = ra_find_named_format(p->ra, "rgb8");
+    if (!format || !format->renderable || !format->linear_filter)
+        format = ra_find_named_format(p->ra, "rgba8");
+    if (!format || !format->renderable || !format->linear_filter)
+        return NULL;
+    return format;
+}
+
+static bool afme_prepare_inputs(struct gl_video *p, struct surface *first,
+                                struct surface *second,
+                                const struct ra_format *format)
+{
+    if (p->afme_source_ids[0] == first->id &&
+        p->afme_source_ids[1] == second->id &&
+        p->afme_input_tex[0] && p->afme_input_tex[1])
+        return true;
+
+    struct surface *sources[2] = {first, second};
+    for (int n = 0; n < 2; n++) {
+        int w = sources[n]->tex->params.w;
+        int h = sources[n]->tex->params.h;
+        if (!ra_tex_resize(p->ra, p->log, &p->afme_input_tex[n],
+                           w, h, format)) {
+            afme_report_event(p, AFME_EVENT_INPUT_ALLOC,
+                              "failed to allocate fixed-point input textures");
+            return false;
+        }
+
+        // Keep the complete mpv/Anime4K surface in FP16. Only this final
+        // GPU-to-GPU pass converts the image to the fixed-point texture type
+        // used by Qualcomm's AFME reference implementation.
+        pass_read_tex(p, sources[n]->tex);
+        pass_describe(p, "AFME fixed-point input %d", n);
+        struct ra_fbo fbo = {.tex = p->afme_input_tex[n]};
+        finish_pass_fbo(p, &fbo, true,
+                        &(struct mp_rect){0, 0, w, h});
+    }
+
+    p->afme_source_ids[0] = first->id;
+    p->afme_source_ids[1] = second->id;
+    p->afme_generated_mask = 0;
+    return true;
+}
+
+static bool afme_resize_output(struct gl_video *p, int index, int w, int h,
+                               const struct ra_format *format)
+{
+    if (ra_tex_resize(p->ra, p->log, &p->afme_tex[index], w, h, format))
+        return true;
+
+    afme_report_event(p, AFME_EVENT_OUTPUT_ALLOC,
+                      "failed to allocate fixed-point output textures");
+    return false;
+}
+
+static bool afme_generate_phase(struct gl_video *p, struct surface *first,
+                                struct surface *second, int phase)
+{
+    p->afme_stats_pair_requests++;
+    mp_assert(phase == 1 || phase == 2);
+    if (!p->afme_extrapolate) {
+        afme_report_event(p, AFME_EVENT_NO_FUNCTION,
+                          "glExtrapolateTex2DQCOM is unavailable");
+        return false;
+    }
+    if (p->afme_failed) {
+        afme_report_event(p, AFME_EVENT_DISABLED_AFTER_GL_ERROR,
+                          "backend was disabled after an OpenGL error");
+        return false;
+    }
+
+    if (first->tex->params.w != second->tex->params.w ||
+        first->tex->params.h != second->tex->params.h ||
+        first->tex->params.format != second->tex->params.format)
+    {
+        afme_report_event(p, AFME_EVENT_SOURCE_MISMATCH,
+                          "source textures do not have matching dimensions and format");
+        return false;
+    }
+
+    const struct ra_format *format = afme_fixed_format(p);
+    if (!format) {
+        afme_report_event(p, AFME_EVENT_UNSUPPORTED_FORMAT,
+                          "no renderable RGB8/RGBA8 texture format");
+        return false;
+    }
+    if (!afme_prepare_inputs(p, first, second, format))
+        return false;
+
+    GLint afme_internal_format = 0;
+    if (!afme_format_supported(p, p->afme_input_tex[0],
+                               &afme_internal_format))
+        return false;
+
+    if (!(p->afme_reported_events & AFME_EVENT_INPUT)) {
+        p->afme_reported_events |= AFME_EVENT_INPUT;
+        MP_INFO(p, "Adreno AFME debug: source=%dx%d %s, fixed-input=%s "
+                "internal-format=0x%x\n", first->tex->params.w,
+                first->tex->params.h, first->tex->params.format->name,
+                format->name, afme_internal_format);
+    }
+
+    int output_index = phase - 1;
+    uint8_t output_bit = 1 << output_index;
+    if ((p->afme_generated_mask & output_bit) && p->afme_tex[output_index]) {
+        p->afme_stats_pair_cache_hits++;
+        return true;
+    }
+
+    if (!afme_resize_output(p, output_index, first->tex->params.w,
+                            first->tex->params.h, format))
+        return false;
+
+    GLuint source_texture[2] = {0};
+    GLuint output_texture = 0;
+    GLenum source_target[2] = {0};
+    GLenum output_target = 0;
+    ra_gl_get_raw_tex(p->ra, p->afme_input_tex[0],
+                      &source_texture[0], &source_target[0]);
+    ra_gl_get_raw_tex(p->ra, p->afme_input_tex[1],
+                      &source_texture[1], &source_target[1]);
+    ra_gl_get_raw_tex(p->ra, p->afme_tex[output_index],
+                      &output_texture, &output_target);
+
+    if (!source_texture[0] || !source_texture[1] ||
+        !output_texture ||
+        source_target[0] != GL_TEXTURE_2D ||
+        source_target[1] != GL_TEXTURE_2D ||
+        output_target != GL_TEXTURE_2D)
+    {
+        afme_report_event(p, AFME_EVENT_RAW_TEXTURE,
+                          "renderer textures are not usable GL_TEXTURE_2D objects");
+        return false;
+    }
+
+    GL *gl = ra_gl_get(p->ra);
+    while (gl->GetError() != GL_NO_ERROR) {}
+
+    // Qualcomm's reference sample submits one positive extrapolation job in
+    // a presentation frame and immediately samples that output. Keep the two
+    // 3x phases on separate presentation frames as well. GLES command order
+    // supplies the texture dependency; a glFinish here can wedge the Adreno
+    // display stack while synchronously waiting for the extension job.
+    p->afme_extrapolate(source_texture[0], source_texture[1],
+                        output_texture, phase / 3.0f);
+
+    GLenum error = gl->GetError();
+    if (error != GL_NO_ERROR) {
+        MP_ERR(p, "Adreno AFME failed with OpenGL error 0x%x; disabling it.\n",
+               error);
+        p->afme_failed = true;
+        return false;
+    }
+
+    p->afme_generated_mask |= output_bit;
+    if (p->afme_generated_mask == 0x3)
+        p->afme_stats_pair_generated++;
+    if (!p->afme_announced) {
+        MP_INFO(p, "Adreno AFME fixed 3x frame generation is active.\n");
+        p->afme_announced = true;
+    }
+    return true;
+}
