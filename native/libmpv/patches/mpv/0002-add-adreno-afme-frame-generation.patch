+static void afme_report_event(struct gl_video *p, uint32_t event,
+                              const char *message)
+{
+    if (p->afme_reported_events & event)
+        return;
+    p->afme_reported_events |= event;
+    MP_WARN(p, "Adreno AFME debug: %s\n", message);
+}
+
+static void afme_report_stats(struct gl_video *p)
+{
+    int64_t now_ns = mp_time_ns();
+    if (!p->afme_stats_last_ns) {
+        p->afme_stats_last_ns = now_ns;
+        return;
+    }
+
+    int64_t elapsed_ns = now_ns - p->afme_stats_last_ns;
+    if (elapsed_ns < MP_TIME_S_TO_NS(1))
+        return;
+
+    uint64_t presented = p->afme_stats_phase[0] +
+                         p->afme_stats_phase[1] +
+                         p->afme_stats_phase[2];
+    double elapsed = MP_TIME_NS_TO_S(elapsed_ns);
+    MP_INFO(p, "Adreno AFME debug: present=%.1f fps phases=%llu/%llu/%llu "
+            "generated-present=%llu pair-requests=%llu cache-hits=%llu "
+            "generated-pairs=%llu bypass-invalid=%llu bypass-still=%llu\n",
+            presented / elapsed,
+            (unsigned long long)p->afme_stats_phase[0],
+            (unsigned long long)p->afme_stats_phase[1],
+            (unsigned long long)p->afme_stats_phase[2],
+            (unsigned long long)p->afme_stats_generated_present,
+            (unsigned long long)p->afme_stats_pair_requests,
+            (unsigned long long)p->afme_stats_pair_cache_hits,
+            (unsigned long long)p->afme_stats_pair_generated,
+            (unsigned long long)p->afme_stats_bypass_invalid,
+            (unsigned long long)p->afme_stats_bypass_still);
+
+    p->afme_stats_last_ns = now_ns;
+    memset(p->afme_stats_phase, 0, sizeof(p->afme_stats_phase));
+    p->afme_stats_generated_present = 0;
+    p->afme_stats_pair_requests = 0;
+    p->afme_stats_pair_cache_hits = 0;
+    p->afme_stats_pair_generated = 0;
+    p->afme_stats_bypass_invalid = 0;
+    p->afme_stats_bypass_still = 0;
+}
+
+static bool afme_resize_output(struct gl_video *p, int index, int w, int h,
+                               const struct ra_format *format)
+{
+    if (ra_tex_resize(p->ra, p->log, &p->afme_tex[index], w, h, format))
+        return true;
+
+    afme_report_event(p, AFME_EVENT_OUTPUT_ALLOC,
+                      "failed to allocate synthesized output textures");
+    return false;
+}
+
+static int afme_align_up(int value, int alignment)
+{
+    return (value + alignment - 1) / alignment * alignment;
+}
+
+static bool afme_prepare_motion(struct gl_video *p, struct surface *first,
+                                struct surface *second)
+{
+    if (!p->afme_estimate_motion) {
+        afme_report_event(p, AFME_EVENT_NO_FUNCTION,
+                          "glTexEstimateMotionQCOM is unavailable");
+        return false;
+    }
+    if (p->afme_failed) {
+        afme_report_event(p, AFME_EVENT_DISABLED_AFTER_GL_ERROR,
+                          "motion backend was disabled after an OpenGL error");
+        return false;
+    }
+
+    int block_w = p->afme_search_block[0];
+    int block_h = p->afme_search_block[1];
+    if (block_w < 1 || block_h < 1) {
+        afme_report_event(p, AFME_EVENT_UNSUPPORTED_FORMAT,
+                          "invalid motion-estimation search block size");
+        return false;
+    }
+
+    int source_w = first->tex->params.w;
+    int source_h = first->tex->params.h;
+    int aligned_w = afme_align_up(source_w, block_w);
+    int aligned_h = afme_align_up(source_h, block_h);
+    int motion_w = aligned_w / block_w;
+    int motion_h = aligned_h / block_h;
+
+    if (p->afme_source_ids[0] == first->id &&
+        p->afme_source_ids[1] == second->id &&
+        p->afme_luma_tex[0] && p->afme_luma_tex[1] &&
+        p->afme_motion_tex[0] && p->afme_motion_tex[1])
+        return true;
+
+    const struct ra_format *luma_format =
+        ra_find_named_format(p->ra, "r8");
+    const struct ra_format *motion_format =
+        ra_find_named_format(p->ra, "rgba16f");
+    if (!luma_format || !luma_format->renderable ||
+        !luma_format->linear_filter || !motion_format ||
+        !motion_format->renderable || !motion_format->linear_filter)
+    {
+        afme_report_event(p, AFME_EVENT_UNSUPPORTED_FORMAT,
+                          "R8/RGBA16F motion textures are unavailable");
+        return false;
+    }
+
+    struct surface *sources[2] = {first, second};
+    for (int n = 0; n < 2; n++) {
+        if (!ra_tex_resize(p->ra, p->log, &p->afme_luma_tex[n],
+                           aligned_w, aligned_h, luma_format)) {
+            afme_report_event(p, AFME_EVENT_INPUT_ALLOC,
+                              "failed to allocate aligned R8 luma inputs");
+            return false;
+        }
+
+        // Motion estimation tracks brightness. Scale only the analysis copy
+        // to a search-block-aligned R8 texture; presentation surfaces remain
+        // untouched at their original size and precision.
+        pass_read_tex(p, sources[n]->tex);
+        GLSL(color = vec4(dot(color.rgb, vec3(0.2126, 0.7152, 0.0722)));)
+        pass_describe(p, "AFME/AME luma input %d", n);
+        struct ra_fbo fbo = {.tex = p->afme_luma_tex[n]};
+        finish_pass_fbo(p, &fbo, true,
+                        &(struct mp_rect){0, 0, aligned_w, aligned_h});
+
+        if (!ra_tex_resize(p->ra, p->log, &p->afme_motion_tex[n],
+                           motion_w, motion_h, motion_format)) {
+            afme_report_event(p, AFME_EVENT_OUTPUT_ALLOC,
+                              "failed to allocate RGBA16F motion fields");
+            return false;
+        }
+    }
+
+    GLuint luma_texture[2] = {0};
+    GLuint motion_texture[2] = {0};
+    GLenum luma_target[2] = {0};
+    GLenum motion_target[2] = {0};
+    for (int n = 0; n < 2; n++) {
+        ra_gl_get_raw_tex(p->ra, p->afme_luma_tex[n],
+                          &luma_texture[n], &luma_target[n]);
+        ra_gl_get_raw_tex(p->ra, p->afme_motion_tex[n],
+                          &motion_texture[n], &motion_target[n]);
+    }
+
+    if (!luma_texture[0] || !luma_texture[1] ||
+        !motion_texture[0] || !motion_texture[1] ||
+        luma_target[0] != GL_TEXTURE_2D ||
+        luma_target[1] != GL_TEXTURE_2D ||
+        motion_target[0] != GL_TEXTURE_2D ||
+        motion_target[1] != GL_TEXTURE_2D)
+    {
+        afme_report_event(p, AFME_EVENT_RAW_TEXTURE,
+                          "motion textures are not usable GL_TEXTURE_2D objects");
+        return false;
+    }
+
+    GL *gl = ra_gl_get(p->ra);
+    while (gl->GetError() != GL_NO_ERROR) {}
+
+    // Compute both directions. The public QCOM motion-estimation extension
+    // writes ordinary RGBA16F vector fields, which are consumed by the normal
+    // GLES shader path below. Never call glExtrapolateTex2DQCOM here: positive
+    // use of that separate extension reproducibly wedged SurfaceFlinger on the
+    // reference Adreno 830 in both FP16 and RGB8 configurations.
+    p->afme_estimate_motion(luma_texture[0], luma_texture[1],
+                            motion_texture[0]);
+    p->afme_estimate_motion(luma_texture[1], luma_texture[0],
+                            motion_texture[1]);
+
+    GLenum error = gl->GetError();
+    if (error != GL_NO_ERROR) {
+        MP_ERR(p, "Adreno AFME/AME motion estimation failed with OpenGL "
+               "error 0x%x; disabling it.\n", error);
+        p->afme_failed = true;
+        return false;
+    }
+
+    p->afme_source_ids[0] = first->id;
+    p->afme_source_ids[1] = second->id;
+    p->afme_generated_mask = 0;
+
+    if (!(p->afme_reported_events & AFME_EVENT_INPUT)) {
+        p->afme_reported_events |= AFME_EVENT_INPUT;
+        MP_INFO(p, "Adreno AFME/AME debug: source=%dx%d, analysis=%dx%d "
+                "R8, block=%dx%d, motion=%dx%d RGBA16F\n",
+                source_w, source_h, aligned_w, aligned_h, block_w, block_h,
+                motion_w, motion_h);
+    }
+    return true;
+}
+
+static bool afme_generate_phase(struct gl_video *p, struct surface *first,
+                                struct surface *second, int phase)
+{
+    p->afme_stats_pair_requests++;
+    mp_assert(phase == 1 || phase == 2);
+
+    if (first->tex->params.w != second->tex->params.w ||
+        first->tex->params.h != second->tex->params.h ||
+        first->tex->params.format != second->tex->params.format)
+    {
+        afme_report_event(p, AFME_EVENT_SOURCE_MISMATCH,
+                          "source textures do not have matching dimensions and format");
+        return false;
+    }
+
+    if (!afme_prepare_motion(p, first, second))
+        return false;
+
+    int output_index = phase - 1;
+    uint8_t output_bit = 1 << output_index;
+    if ((p->afme_generated_mask & output_bit) && p->afme_tex[output_index]) {
+        p->afme_stats_pair_cache_hits++;
+        return true;
+    }
+
+    const struct ra_format *output_format = first->tex->params.format;
+    if (!output_format || !output_format->renderable ||
+        !output_format->linear_filter)
+        output_format = p->fbo_format;
+    if (!afme_resize_output(p, output_index, first->tex->params.w,
+                            first->tex->params.h, output_format))
+        return false;
+
+    int aligned_w = p->afme_luma_tex[0]->params.w;
+    int aligned_h = p->afme_luma_tex[0]->params.h;
+    float analysis_size[2] = {aligned_w, aligned_h};
+    float mix = phase / 3.0f;
+
+    // The motion vectors are expressed in aligned-analysis pixels. Two
+    // fixed-point inverse-warp iterations map each intermediate pixel back to
+    // both original frames. Forward/backward consistency reduces ghosting at
+    // occlusions without feeding either synthesized result back as an input.
+    pass_read_tex(p, first->tex);
+    gl_sc_uniform_texture(p->sc, "afme_next", second->tex);
+    gl_sc_uniform_texture(p->sc, "afme_flow01", p->afme_motion_tex[0]);
+    gl_sc_uniform_texture(p->sc, "afme_flow10", p->afme_motion_tex[1]);
+    gl_sc_uniform_dynamic(p->sc);
+    gl_sc_uniform_f(p->sc, "afme_mix", mix);
+    gl_sc_uniform_vec2(p->sc, "afme_analysis_size", analysis_size);
+    GLSL(vec2 afme_uv = texcoord0;)
+    GLSL(vec2 afme_q0 = afme_uv;)
+    GLSL(vec2 afme_q1 = afme_uv;)
+    GLSL(vec2 afme_d0 = texture(afme_flow01,
+                                clamp(afme_q0, 0.0, 1.0)).rg /
+                         afme_analysis_size;)
+    GLSL(afme_q0 = afme_uv - afme_mix * afme_d0;)
+    GLSL(afme_d0 = texture(afme_flow01,
+                           clamp(afme_q0, 0.0, 1.0)).rg /
+                    afme_analysis_size;)
+    GLSL(afme_q0 = afme_uv - afme_mix * afme_d0;)
+    GLSL(vec2 afme_d1 = texture(afme_flow10,
+                                clamp(afme_q1, 0.0, 1.0)).rg /
+                         afme_analysis_size;)
+    GLSL(afme_q1 = afme_uv - (1.0 - afme_mix) * afme_d1;)
+    GLSL(afme_d1 = texture(afme_flow10,
+                           clamp(afme_q1, 0.0, 1.0)).rg /
+                    afme_analysis_size;)
+    GLSL(afme_q1 = afme_uv - (1.0 - afme_mix) * afme_d1;)
+    GLSL(vec2 afme_back0 = texture(afme_flow10,
+                    clamp(afme_q0 + afme_d0, 0.0, 1.0)).rg;)
+    GLSL(vec2 afme_back1 = texture(afme_flow01,
+                    clamp(afme_q1 + afme_d1, 0.0, 1.0)).rg;)
+    GLSL(vec2 afme_px0 = afme_d0 * afme_analysis_size;)
+    GLSL(vec2 afme_px1 = afme_d1 * afme_analysis_size;)
+    GLSL(float afme_err0 = length(afme_px0 + afme_back0);)
+    GLSL(float afme_err1 = length(afme_px1 + afme_back1);)
+    GLSL(float afme_lim0 = 0.75 + 0.05 *
+                    (length(afme_px0) + length(afme_back0));)
+    GLSL(float afme_lim1 = 0.75 + 0.05 *
+                    (length(afme_px1) + length(afme_back1));)
+    GLSL(float afme_conf0 = 1.0 - smoothstep(afme_lim0,
+                                             afme_lim0 * 3.0,
+                                             afme_err0);)
+    GLSL(float afme_conf1 = 1.0 - smoothstep(afme_lim1,
+                                             afme_lim1 * 3.0,
+                                             afme_err1);)
+    GLSL(float afme_inside0 = step(0.0, afme_q0.x) *
+                                  step(afme_q0.x, 1.0) *
+                                  step(0.0, afme_q0.y) *
+                                  step(afme_q0.y, 1.0);)
+    GLSL(float afme_inside1 = step(0.0, afme_q1.x) *
+                                  step(afme_q1.x, 1.0) *
+                                  step(0.0, afme_q1.y) *
+                                  step(afme_q1.y, 1.0);)
+    GLSL(float afme_w0 = (1.0 - afme_mix) * afme_inside0 *
+                         (0.05 + 0.95 * afme_conf0);)
+    GLSL(float afme_w1 = afme_mix * afme_inside1 *
+                         (0.05 + 0.95 * afme_conf1);)
+    GLSL(float afme_wsum = max(afme_w0 + afme_w1, 1e-5);)
+    GLSL(vec4 afme_c0 = texture(texture0, clamp(afme_q0, 0.0, 1.0));)
+    GLSL(vec4 afme_c1 = texture(afme_next, clamp(afme_q1, 0.0, 1.0));)
+    GLSL(color = (afme_w0 * afme_c0 + afme_w1 * afme_c1) / afme_wsum;)
+    pass_describe(p, "AFME/AME bidirectional synthesis phase %d", phase);
+    struct ra_fbo output_fbo = {.tex = p->afme_tex[output_index]};
+    finish_pass_fbo(p, &output_fbo, true,
+                    &(struct mp_rect){0, 0, first->tex->params.w,
+                                      first->tex->params.h});
+
+    p->afme_generated_mask |= output_bit;
+    if (p->afme_generated_mask == 0x3)
+        p->afme_stats_pair_generated++;
+    if (!p->afme_announced) {
+        MP_INFO(p, "Adreno AFME/AME fixed 3x motion-compensated frame "
+                "generation is active.\n");
+        p->afme_announced = true;
+    }
+    return true;
+}
