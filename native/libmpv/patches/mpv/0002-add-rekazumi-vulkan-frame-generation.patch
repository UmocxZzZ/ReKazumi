+static bool framegen_generate(struct vo *vo, const struct pl_frame_mix *mix,
+                              int phase, struct pl_frame *out)
+{
+    struct priv *p = vo->priv;
+    int first = -1, second = -1;
+    for (int i = 0; i < mix->num_frames; i++) {
+        if (mix->timestamps[i] <= 0.0f)
+            first = i;
+        else if (second < 0)
+            second = i;
+    }
+    if (phase < 1 || phase > 2 || first < 0 || second < 0)
+        return false;
+
+    int w = pl_rect_w(mix->frames[first]->crop);
+    int h = pl_rect_h(mix->frames[first]->crop);
+    if (w <= 0 || h <= 0 ||
+        w != (int) pl_rect_w(mix->frames[second]->crop) ||
+        h != (int) pl_rect_h(mix->frames[second]->crop))
+        return framegen_fail(vo, "source pair dimensions do not match");
+
+    if (!framegen_prepare_pair(vo, mix->frames[first], mix->frames[second],
+                               mix->signatures[first], mix->signatures[second],
+                               w, h))
+        return false;
+
+    unsigned bit = 1u << (phase - 1);
+    if (!(p->framegen_output_mask & bit)) {
+        if (!framegen_recreate_tex(vo, &p->framegen_output[phase - 1], w, h) ||
+            !framegen_dispatch_warp(vo, phase, w, h))
+            return false;
+        p->framegen_output_mask |= bit;
+    }
+
+    *out = framegen_rgb_frame(p->framegen_output[phase - 1], mix->frames[first]);
+    if (!p->framegen_announced) {
+        MP_INFO(vo, "ReKazumi Vulkan fixed 3x frame generation prototype active\n");
+        p->framegen_announced = true;
+    }
+    return true;
+}
