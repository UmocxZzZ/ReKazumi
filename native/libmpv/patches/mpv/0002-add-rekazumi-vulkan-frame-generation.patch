+static bool framegen_fail(struct vo *vo, const char *reason)
+{
+    struct priv *p = vo->priv;
+    if (!p->framegen_failed)
+        MP_ERR(vo, "ReKazumi frame generation disabled: %s\n", reason);
+    p->framegen_failed = true;
+    vo_set_frame_generation(vo, 1);
+    return false;
+}
+
+static pl_fmt framegen_format(struct priv *p)
+{
+    enum pl_fmt_caps caps = PL_FMT_CAP_SAMPLEABLE | PL_FMT_CAP_RENDERABLE |
+                            PL_FMT_CAP_STORABLE;
+    return pl_find_fmt(p->gpu, PL_FMT_FLOAT, 4, 16, 0, caps);
+}
+
+static bool framegen_recreate_tex(struct vo *vo, pl_tex *tex, int w, int h)
+{
+    struct priv *p = vo->priv;
+    pl_fmt format = framegen_format(p);
+    if (!format)
+        return framegen_fail(vo, "no sampleable/renderable/storable FP16 format");
+
+    if (!pl_tex_recreate(p->gpu, tex, pl_tex_params(
+            .w = w,
+            .h = h,
+            .format = format,
+            .sampleable = true,
+            .renderable = true,
+            .storable = true)))
+        return framegen_fail(vo, "offscreen texture allocation failed");
+    return true;
+}
+
+static struct pl_frame framegen_rgb_frame(pl_tex tex,
+                                           const struct pl_frame *reference)
+{
+    struct pl_frame frame = {
+        .num_planes = 1,
+        .planes = {{
+            .texture = tex,
+            .components = 4,
+            .component_mapping = {0, 1, 2, 3},
+        }},
+        .repr = {
+            .sys = PL_COLOR_SYSTEM_RGB,
+            .levels = PL_COLOR_LEVELS_FULL,
+            .alpha = PL_ALPHA_INDEPENDENT,
+        },
+        .color = reference->color,
+        .crop = {0, 0, tex->params.w, tex->params.h},
+    };
+    return frame;
+}
+
+static bool framegen_render_source(struct vo *vo, int index,
+                                   const struct pl_frame *source, int w, int h)
+{
+    struct priv *p = vo->priv;
+    if (!framegen_recreate_tex(vo, &p->framegen_source[index], w, h))
+        return false;
+
+    struct pl_frame input = *source;
+    input.num_overlays = 0;
+    struct pl_frame target = framegen_rgb_frame(p->framegen_source[index], source);
+    struct pl_render_params params = pl_render_default_params;
+    params.skip_caching_single_frame = false;
+    params.preserve_mixing_cache = true;
+    if (!pl_render_image(p->rr, &input, &target, &params))
+        return framegen_fail(vo, "source RGB conversion failed");
+    return true;
+}
