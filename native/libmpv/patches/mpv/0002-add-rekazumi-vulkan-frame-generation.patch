+static bool framegen_dispatch_motion(struct vo *vo, int motion_w, int motion_h)
+{
+    struct priv *p = vo->priv;
+    static const char motion_header[] =
+        "float fg_luma(vec3 c) { return dot(c, vec3(0.2126, 0.7152, 0.0722)); }\n";
+    static const char motion_body[] =
+        "ivec2 block = ivec2(gl_GlobalInvocationID.xy);\n"
+        "ivec2 field_size = imageSize(fg_motion_out);\n"
+        "if (any(greaterThanEqual(block, field_size))) return;\n"
+        "ivec2 image_size = textureSize(fg_source_a, 0);\n"
+        "vec2 px = 1.0 / vec2(image_size);\n"
+        "vec2 center = (vec2(block) + 0.5) / vec2(field_size);\n"
+        "vec2 best_f = vec2(0.0), best_b = vec2(0.0);\n"
+        "float best_f_cost = 1e20, best_b_cost = 1e20;\n"
+        "const vec2 taps[5] = vec2[5](vec2(0.0), vec2(-4.0, 0.0), "
+        "vec2(4.0, 0.0), vec2(0.0, -4.0), vec2(0.0, 4.0));\n"
+        "for (int cy = -12; cy <= 12; cy += 2) {\n"
+        " for (int cx = -12; cx <= 12; cx += 2) {\n"
+        "  vec2 candidate = vec2(cx, cy);\n"
+        "  float cost_f = 0.0, cost_b = 0.0;\n"
+        "  for (int tap = 0; tap < 5; tap++) {\n"
+        "   vec2 base = taps[tap] * px;\n"
+        "   float a0 = fg_luma(textureLod(fg_source_a, clamp(center + base, 0.0, 1.0), 0.0).rgb);\n"
+        "   float b0 = fg_luma(textureLod(fg_source_b, clamp(center + base, 0.0, 1.0), 0.0).rgb);\n"
+        "   float ac = fg_luma(textureLod(fg_source_a, clamp(center + base + candidate * px, 0.0, 1.0), 0.0).rgb);\n"
+        "   float bc = fg_luma(textureLod(fg_source_b, clamp(center + base + candidate * px, 0.0, 1.0), 0.0).rgb);\n"
+        "   cost_f += abs(a0 - bc);\n"
+        "   cost_b += abs(b0 - ac);\n"
+        "  }\n"
+        "  cost_f += 0.001 * length(candidate);\n"
+        "  cost_b += 0.001 * length(candidate);\n"
+        "  if (cost_f < best_f_cost) { best_f_cost = cost_f; best_f = candidate; }\n"
+        "  if (cost_b < best_b_cost) { best_b_cost = cost_b; best_b = candidate; }\n"
+        " }\n"
+        "}\n"
+        "imageStore(fg_motion_out, block, vec4(best_f, best_b));\n";
+
+    struct pl_shader_desc descriptors[] = {
+        {
+            .desc = {.name = "fg_source_a", .type = PL_DESC_SAMPLED_TEX},
+            .binding = {.object = p->framegen_source[0],
+                        .sample_mode = PL_TEX_SAMPLE_LINEAR},
+        }, {
+            .desc = {.name = "fg_source_b", .type = PL_DESC_SAMPLED_TEX},
+            .binding = {.object = p->framegen_source[1],
+                        .sample_mode = PL_TEX_SAMPLE_LINEAR},
+        }, {
+            .desc = {.name = "fg_motion_out", .type = PL_DESC_STORAGE_IMG,
+                     .access = PL_DESC_ACCESS_WRITEONLY},
+            .binding = {.object = p->framegen_motion},
+        },
+    };
+    pl_shader sh = pl_dispatch_begin(p->framegen_dispatch);
+    if (!pl_shader_custom(sh, &(struct pl_custom_shader) {
+            .header = motion_header,
+            .description = "ReKazumi coarse bidirectional block motion",
+            .body = motion_body,
+            .output = PL_SHADER_SIG_NONE,
+            .descriptors = descriptors,
+            .num_descriptors = MP_ARRAY_SIZE(descriptors),
+            .compute = true,
+            .compute_group_size = {8, 8},
+            .output_w = motion_w,
+            .output_h = motion_h,
+        }))
+    {
+        pl_dispatch_abort(p->framegen_dispatch, &sh);
+        return framegen_fail(vo, "motion shader creation failed");
+    }
+
+    if (!pl_dispatch_compute(p->framegen_dispatch, pl_dispatch_compute_params(
+            .shader = &sh,
+            .dispatch_size = {MP_ALIGN_UP(motion_w, 8) / 8,
+                              MP_ALIGN_UP(motion_h, 8) / 8, 1},
+            .width = motion_w,
+            .height = motion_h)))
+        return framegen_fail(vo, "motion shader dispatch failed");
+    return true;
+}
+
+static bool framegen_prepare_pair(struct vo *vo, const struct pl_frame *first,
+                                  const struct pl_frame *second,
+                                  uint64_t first_id, uint64_t second_id,
+                                  int w, int h)
+{
+    struct priv *p = vo->priv;
+    if (p->framegen_failed || !p->framegen_vulkan || !p->framegen_dispatch)
+        return false;
+    if (p->framegen_pair[0] == first_id && p->framegen_pair[1] == second_id &&
+        p->framegen_motion)
+        return true;
+
+    int motion_w = MP_ALIGN_UP(w, 16) / 16;
+    int motion_h = MP_ALIGN_UP(h, 16) / 16;
+    pl_dispatch_reset_frame(p->framegen_dispatch);
+    if (!framegen_render_source(vo, 0, first, w, h) ||
+        !framegen_render_source(vo, 1, second, w, h) ||
+        !framegen_recreate_tex(vo, &p->framegen_motion, motion_w, motion_h) ||
+        !framegen_dispatch_motion(vo, motion_w, motion_h))
+        return false;
+
+    p->framegen_pair[0] = first_id;
+    p->framegen_pair[1] = second_id;
+    p->framegen_output_mask = 0;
+    return true;
+}
+
+static bool framegen_dispatch_warp(struct vo *vo, int phase, int w, int h)
+{
+    struct priv *p = vo->priv;
+    char body[4096];
+    snprintf(body, sizeof(body),
+        "ivec2 pixel = ivec2(gl_GlobalInvocationID.xy);\n"
+        "ivec2 image_size = imageSize(fg_output);\n"
+        "if (any(greaterThanEqual(pixel, image_size))) return;\n"
+        "vec2 size = vec2(image_size);\n"
+        "vec2 uv = (vec2(pixel) + 0.5) / size;\n"
+        "float t = %.9f;\n"
+        "vec4 motion = textureLod(fg_motion, uv, 0.0);\n"
+        "vec2 uv_a = uv - t * motion.xy / size;\n"
+        "vec2 uv_b = uv - (1.0 - t) * motion.zw / size;\n"
+        "vec4 local_a = textureLod(fg_motion, clamp(uv_a, 0.0, 1.0), 0.0);\n"
+        "vec4 local_b = textureLod(fg_motion, clamp(uv_b, 0.0, 1.0), 0.0);\n"
+        "vec4 peer_a = textureLod(fg_motion, clamp(uv_a + local_a.xy / size, 0.0, 1.0), 0.0);\n"
+        "vec4 peer_b = textureLod(fg_motion, clamp(uv_b + local_b.zw / size, 0.0, 1.0), 0.0);\n"
+        "float err_a = length(local_a.xy + peer_a.zw);\n"
+        "float err_b = length(local_b.zw + peer_b.xy);\n"
+        "float conf_a = 1.0 - smoothstep(1.0, 4.0, err_a);\n"
+        "float conf_b = 1.0 - smoothstep(1.0, 4.0, err_b);\n"
+        "float inside_a = all(greaterThanEqual(uv_a, vec2(0.0))) && all(lessThanEqual(uv_a, vec2(1.0))) ? 1.0 : 0.0;\n"
+        "float inside_b = all(greaterThanEqual(uv_b, vec2(0.0))) && all(lessThanEqual(uv_b, vec2(1.0))) ? 1.0 : 0.0;\n"
+        "float wa = (1.0 - t) * inside_a * (0.05 + 0.95 * conf_a);\n"
+        "float wb = t * inside_b * (0.05 + 0.95 * conf_b);\n"
+        "vec4 a = textureLod(fg_source_a, clamp(uv_a, 0.0, 1.0), 0.0);\n"
+        "vec4 b = textureLod(fg_source_b, clamp(uv_b, 0.0, 1.0), 0.0);\n"
+        "vec4 result = (wa * a + wb * b) / max(wa + wb, 1e-5);\n"
+        "imageStore(fg_output, pixel, result);\n",
+        phase / 3.0);
+
+    struct pl_shader_desc descriptors[] = {
+        {
+            .desc = {.name = "fg_source_a", .type = PL_DESC_SAMPLED_TEX},
+            .binding = {.object = p->framegen_source[0],
+                        .sample_mode = PL_TEX_SAMPLE_LINEAR},
+        }, {
+            .desc = {.name = "fg_source_b", .type = PL_DESC_SAMPLED_TEX},
+            .binding = {.object = p->framegen_source[1],
+                        .sample_mode = PL_TEX_SAMPLE_LINEAR},
+        }, {
+            .desc = {.name = "fg_motion", .type = PL_DESC_SAMPLED_TEX},
+            .binding = {.object = p->framegen_motion,
+                        .sample_mode = PL_TEX_SAMPLE_LINEAR},
+        }, {
+            .desc = {.name = "fg_output", .type = PL_DESC_STORAGE_IMG,
+                     .access = PL_DESC_ACCESS_WRITEONLY},
+            .binding = {.object = p->framegen_output[phase - 1]},
+        },
+    };
+    pl_shader sh = pl_dispatch_begin(p->framegen_dispatch);
+    if (!pl_shader_custom(sh, &(struct pl_custom_shader) {
+            .description = phase == 1 ? "ReKazumi warp 1/3" : "ReKazumi warp 2/3",
+            .body = body,
+            .output = PL_SHADER_SIG_NONE,
+            .descriptors = descriptors,
+            .num_descriptors = MP_ARRAY_SIZE(descriptors),
+            .compute = true,
+            .compute_group_size = {8, 8},
+            .output_w = w,
+            .output_h = h,
+        }))
+    {
+        pl_dispatch_abort(p->framegen_dispatch, &sh);
+        return framegen_fail(vo, "warp shader creation failed");
+    }
+
+    if (!pl_dispatch_compute(p->framegen_dispatch, pl_dispatch_compute_params(
+            .shader = &sh,
+            .dispatch_size = {MP_ALIGN_UP(w, 8) / 8,
+                              MP_ALIGN_UP(h, 8) / 8, 1},
+            .width = w,
+            .height = h)))
+        return framegen_fail(vo, "warp shader dispatch failed");
+    return true;
+}
